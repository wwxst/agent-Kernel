# 复制成 .env 后填写；npm run agent 会用 --env-file-if-exists 自动加载。
# 任意 OpenAI 兼容端点都行，下面是 DeepSeek 的例子：DeepSeek-V4.1-Flash 的 id 是 deepseek-flash。
BASE_URL=https://api.deepseek.com
API_KEY=sk-your-key-here
MODEL=deepseek-flash

# 只有自己另行运行外部 Mock 服务器时才设为 1。
# 该变量仅在界面中标记“演示”，不会自动启动 Mock，也不会绕过 API Key 检查。
# AGENT_DEMO=1

# 工具允许读写的根目录；不填就是运行命令时所在的目录。
# WORKDIR=.

# 一次任务最多请求模型多少次（一次「说话」或一轮「调工具」算一次）。
# MAX_STEPS=30

# 一次任务最多真正执行多少次工具调用；和上面的模型请求次数是两个预算。
# MAX_TOOL_CALLS=60

# 一次任务累计 token 预算（prompt + completion）；只统计端点报告了 usage 的部分，0 表示不限制。
# MAX_TOTAL_TOKENS=500000

# 单次模型响应最多生成多少 token。
# MAX_OUTPUT_TOKENS=8192

# 单条 shell 命令的超时，单位毫秒。
# TOOL_TIMEOUT_MS=120000

# CLI 展示：compact 每个工具一行；detailed 独立展开每个工具的结果（最多 4000 字符）。
# 也可以在命令行加 --details 临时开启详细模式。
# AGENT_VIEW=compact

# 台词风格：balanced 混合六种性格；也可固定一种。
# energetic 元气 / playful 调皮 / tsundere 傲娇 / curious 好奇 / gentle 温柔 / confident 可靠。
# AGENT_VOICE=balanced
